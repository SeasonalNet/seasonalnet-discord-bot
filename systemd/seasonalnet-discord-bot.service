[Unit]
Description=SeasonalNet Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seasonal
Group=seasonal
WorkingDirectory=/opt/seasonalnet/discord-bot
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/src/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
