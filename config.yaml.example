bot:
  token_env: SEASONALNET_BOT_TOKEN
  client_id_env: SEASONALNET_BOT_CLIENT_ID
  guild_id_env: SEASONALNET_BOT_GUILD_ID
  activity: SeasonalNet workflows
  status: online
  allowed_guild_ids:
    - '123456789012345678'

database:
  path: /var/lib/seasonalnet/discord-bot/bot.db

logging:
  level: info

scopes:
  defaults:
    - utility.use
  grants:
    - match:
        guild_ids:
          - '123456789012345678'
        role_names:
          - Owner
      scopes:
        - utility.inspect
        - agents.use
        - moderation.manage
        - moderation.member
    - match:
        guild_ids:
          - '123456789012345678'
        role_names:
          - Admins
      scopes:
        - utility.inspect
        - agents.use
        - moderation.manage
        - moderation.member
    - match:
        guild_ids:
          - '123456789012345678'
        role_names:
          - Mods
      scopes:
        - utility.inspect
        - moderation.manage

integrations:
  seasonal_agent:
    enabled: true
    base_url: http://127.0.0.1:8765
    timeout_ms: 30000
    bot_token_env: SEASONAL_AGENT_BOT_TOKEN

agents:
  max_question_length: 1500
  session_mode: per_user_in_channel
  default_target: seasonalnet
  targets:
    seasonalnet:
      display_name: SeasonalNet
      description: General SeasonalNet assistant workflows.
      agent_profile: seasonalnet
      enabled: true
    homelab:
      display_name: Homelab
      description: Homelab and infrastructure inspection workflows.
      agent_profile: homelab
      enabled: true
    repo:
      display_name: Repo
      description: Read-only repository inspection workflows.
      agent_profile: repo
      enabled: true

moderation:
  max_purge_count: 100
  lock_reason: Locked by SeasonalNet bot
  unlock_reason: Unlocked by SeasonalNet bot
  dm_notices:
    enabled: true
    footer: If you believe this action was made in error, contact the server staff.
    actions:
      warn:
        title: SeasonalNet moderation notice
        body: |
          A moderation action was recorded in **{guild_name}**.

          Action: **{action_label}**
          Reason: {reason}
          Moderator: {moderator_tag}
          Case: #{case_id}
      note:
        title: SeasonalNet moderation note
        body: |
          A moderator recorded a note for your account in **{guild_name}**.

          Action: **{action_label}**
          Reason: {reason}
          Moderator: {moderator_tag}
          Case: #{case_id}
      timeout:
        title: SeasonalNet timeout notice
        body: |
          You were timed out in **{guild_name}**.

          Action: **{action_label}**
          Duration: {duration_minutes} minute(s)
          Reason: {reason}
          Moderator: {moderator_tag}
          Case: #{case_id}
      untimeout:
        title: SeasonalNet timeout update
        body: |
          Your timeout in **{guild_name}** was cleared.

          Action: **{action_label}**
          Reason: {reason}
          Moderator: {moderator_tag}
          Case: #{case_id}
      kick:
        title: SeasonalNet removal notice
        body: |
          You were removed from **{guild_name}**.

          Action: **{action_label}**
          Reason: {reason}
          Moderator: {moderator_tag}
          Case: #{case_id}
      ban:
        title: SeasonalNet ban notice
        body: |
          You were banned from **{guild_name}**.

          Action: **{action_label}**
          Reason: {reason}
          Moderator: {moderator_tag}
          Case: #{case_id}
      unban:
        title: SeasonalNet unban notice
        body: |
          Your ban in **{guild_name}** was lifted.

          Action: **{action_label}**
          Reason: {reason}
          Moderator: {moderator_tag}
          Case: #{case_id}
      softban:
        title: SeasonalNet softban notice
        body: |
          You were softbanned from **{guild_name}**. Your recent messages were deleted, but you may rejoin at any time.

          Action: **{action_label}**
          Reason: {reason}
          Moderator: {moderator_tag}
          Case: #{case_id}

cdn:
  # Base URL for the SeasonalNet icon CDN (Lucide icon PNG renderer).
  # Override only if running the CDN at a non-standard location.
  icon_base_url: https://cdn.seasonalnet.org
