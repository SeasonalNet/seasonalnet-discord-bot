{
  "name": "seasonalnet-discord-bot",
  "version": "0.5.0",
  "private": true,
  "description": "Shared SeasonalNet Discord bot with utility, moderation, and agent workflows.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.26.2",
    "dotenv": "^17.2.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
