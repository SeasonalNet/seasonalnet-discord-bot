{
  "name": "seasonalnet-discord-bot",
  "version": "0.5.1",
  "private": true,
  "description": "Shared SeasonalNet Discord bot with utility, moderation, and agent workflows.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.17.0"
}
